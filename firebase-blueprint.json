  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user PII isolated to owner and admins"
    },
    "/members/{userId}": {
      "schema": { "$ref": "#/entities/MemberProfile" },
      "description": "Public NPO team member directory without PII"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collaborative NPO initiatives across Learn, Create, and Empower"
    },
    "/projects/{projectId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ProjectComment" },
      "description": "Discussion comments on a project initiative"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks linked to NPO projects"
    },
    "/tasks/{taskId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/TaskComment" },
      "description": "Discussion comments under a task"
    },
    "/patterns/{patternId}": {
      "schema": { "$ref": "#/entities/PatternBoard" },
      "description": "Collaborative geometric pattern canvases"
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/Channel" },
      "description": "Team collaboration channels"
    },
    "/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Real-time messages inside collaboration channels"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourceItem" },
      "description": "Shared NPO guides, templates, worksheets, and toolkits"
    },
    "/users/{userId}/bookmarks/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourceBookmark" },
      "description": "Per-user bookmarked team resources and documents"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/WorkspaceNotification" },
      "description": "User-scoped notifications for task assignments and comment mentions"
    }
  }
}
