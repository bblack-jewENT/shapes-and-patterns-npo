{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user PII and preferences isolated from public directory",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "notificationDigest": {
          "type": "string",
          "enum": ["daily", "weekly", "none"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "notificationDigest", "updatedAt"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Public Shapes and Patterns NPO team directory profile without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orgId": {
          "type": "string",
          "enum": ["shapes-and-patterns-npo"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["admin", "lead", "educator", "volunteer"]
        },
        "pillarFocus": {
          "type": "string",
          "enum": ["learn", "create", "empower", "operations"]
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "maxLength": 280
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "orgId",
        "displayName",
        "role",
        "pillarFocus",
        "joinedAt",
        "updatedAt"
      ]
    },
